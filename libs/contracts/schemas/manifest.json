{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MediaManifest",
  "description": "Compact metadata manifest synced to cloud catalog (must remain <= 3 KB)",
  "type": "object",
  "required": [
    "schema_version",
    "media_id",
    "node_id",
    "title",
    "duration_s",
    "content_hash",
    "renditions",
    "is_public",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "media_id": {
      "type": "string",
      "format": "uuid"
    },
    "node_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "duration_s": {
      "type": "integer",
      "minimum": 1
    },
    "content_hash": {
      "type": "string",
      "description": "SHA-256 hash of original source media"
    },
    "renditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resolution", "bitrate_bps", "playlist_path", "chunk_duration_s"],
        "properties": {
          "resolution": {
            "type": "string",
            "enum": ["1080p", "720p", "480p"]
          },
          "bitrate_bps": {
            "type": "integer",
            "minimum": 100000
          },
          "playlist_path": {
            "type": "string"
          },
          "chunk_duration_s": {
            "type": "integer",
            "enum": [4]
          }
        }
      }
    },
    "is_public": {
      "type": "boolean"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
